# Default path: local Ollama. No API key required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Context window sent to Ollama. A short failure batch fits easily.
OLLAMA_NUM_CTX=8192

# ollama (default) or openai (any OpenAI-compatible /chat/completions server).
# Used only when you pass --summarize and at least one check failed.
API_WATCH_PROVIDER=ollama

# Seconds to wait for the model call.
API_WATCH_TIMEOUT=120

# Optional OpenAI-compatible path. Used only when API_WATCH_PROVIDER=openai.
# api.openai.com requires OPENAI_API_KEY. A local compatible server may omit it.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional failure webhook. When any check fails, api-watch POSTs the run JSON here.
# No Slack or email SDK. Leave unset to alert on stderr only.
# API_WATCH_WEBHOOK_URL=

# Example referenced by samples/endpoints.yaml. Not a secret.
# API_WATCH_SOURCE=local-demo
